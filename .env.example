########################################################################
# Chrome-extension bridge — BRIDGE_TOKEN IS REQUIRED
########################################################################
# BRIDGE_TOKEN is the shared secret between mcp_server.py and the Chrome
# extension. NOTHING WORKS UNTIL BOTH SIDES HOLD THE SAME VALUE — with a
# mismatch the extension is rejected with WebSocket close code 1008 and simply
# never connects.
#
# Leave it EMPTY below and mcp_server.py generates a token on first start and
# writes it back into YOUR .env (not this example file). Then:
#   1. open .env and copy the BRIDGE_TOKEN value
#   2. open the ChromeBridge side panel in Chrome
#   3. paste it into the Token field -> Save & Connect
# Both sides remember it across restarts; you do this once.
#
# To choose your own instead, put any non-empty random string here, e.g.
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(16))"
BRIDGE_TOKEN=

# Optional overrides (defaults shown)
# BRIDGE_HOST=127.0.0.1
#
# BRIDGE_PORT is the FIRST port tried, not the only one: the server binds the
# first free port in BRIDGE_PORT..BRIDGE_PORT+9 so a second Claude Code session
# does not die on "address in use". The extension probes the same 10-port span,
# so if you move this you must move it in the extension too.
# BRIDGE_PORT=8765

########################################################################
# Logging (OPTIONAL) — one of DEBUG, INFO, WARNING, ERROR
########################################################################
LOG_LEVEL=INFO

# NOTE: No LLM API keys needed — Claude Code is the agent and runs on your
# Claude subscription. (Old AGENTIC_BROWSER_* / OPENAI_* vars are only used by
# the retired legacy/ entry points.)
