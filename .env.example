########################################################################
# Chrome-extension bridge
########################################################################
# Set any non-empty random string here, then paste the SAME string once into
# the extension side panel's Token field (Save & Connect). Both sides remember
# it across restarts.
BRIDGE_TOKEN=

# Optional overrides (defaults shown)
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8765

########################################################################
# Logging (OPTIONAL) — one of DEBUG, INFO, WARNING, ERROR
########################################################################
LOG_LEVEL=INFO

# NOTE: No LLM API keys needed — Claude Code is the agent and runs on your
# Claude subscription. (Old AGENTIC_BROWSER_* / OPENAI_* vars are only used by
# the retired legacy/ entry points.)
