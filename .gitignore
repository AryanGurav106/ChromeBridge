.env
secrets/local_secrets.json
temp/
__pycache__/
*.pyc
.venv/
browser_storage/

# Packaging artifacts. `pip install -e .` is the install the README now tells
# contributors to run, and it drops chromebridge.egg-info/ in the repo root.
*.egg-info/
build/
dist/

# Flows recorded against PRIVATE applications. These were in .git/info/exclude,
# which is per-clone and never travels -- so the protection existed only on the
# machine that set it up, and a collaborator recording against the same app got
# none of it. C29 in tools/test_contracts.py reads the exclude list and fails on
# any tracked file containing an excluded flow's own origin; that check travels,
# the exclusion did not. Both are kept: the exclude list still covers a clone
# that predates this line.
flows/crm-*.flow.json
flows/boxsy-*.flow.json

# Files an eval agent downloads into the repo root while driving the benchmark
# (WebPageBench's files tasks end in a real browser download). Widened after a
# second task produced `lab-reports-2024 (1).pdf` -- naming one file is how the
# next one gets committed by accident.
project-archive-*.csv
lab-reports-*.pdf
lab-reports-*.csv
