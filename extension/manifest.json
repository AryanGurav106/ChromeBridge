{
  "manifest_version": 3,
  "name": "ChromeBridge",
  "version": "0.1.0",
  "description": "Local bridge — lets Claude Code drive this Chrome window, with your real logins and cookies, through a local WebSocket.",
  "permissions": [
    "scripting",
    "tabs",
    "tabGroups",
    "activeTab",
    "storage",
    "sidePanel",
    "debugger",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["listener_tag.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChromeBridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "panel.html" }
}
